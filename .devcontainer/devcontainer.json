// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "Mocking Static Methods - Multi-Project .NET Build Environment",
	
	// Use custom Dockerfile to fix yarn GPG key issue before installing features
	"build": {
		"dockerfile": "Dockerfile"
	},
	
	// Initialize command to fix yarn repo issue before features are installed
	"initializeCommand": "echo 'Preparing devcontainer...'",
	
	// On create, remove the problematic yarn repository before installing features
	"onCreateCommand": "sudo rm -f /etc/apt/sources.list.d/yarn.list || true",
	
	"features": {
		// Python for orchestrator and analysis tools
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.12",
			"installTools": true
		}
	},
	
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csharp",
				"ms-dotnettools.csdevkit",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"coverlet.vscode-coverlet",
				"ms-azuretools.vscode-docker"
			]
		}
	},
	
	// Run setup commands after container is created
	"postCreateCommand": "bash -c 'pip install -r requirements.txt 2>/dev/null || true && dotnet tool install -g dotnet-reportgenerator-globaltool 2>/dev/null || true'",
	
	// Install mono-complete in background after container starts (won't block connection)
	"postStartCommand": "bash -c 'echo \"Installing mono-complete (this may take 5-10 minutes)...\" && sudo apt-get update -qq && sudo apt-get install -y mono-complete && echo \"mono-complete installation complete!\"'",
	
	// Environment variables
	"remoteEnv": {
		"DOTNET_CLI_TELEMETRY_OPTOUT": "1"
	},
	
	"runArgs": ["--name", "mocking-static-methods-devcontainer"]
}
