{
	"name": "GitHub Actions Runner - Local Testing",
	"build": {
		"dockerfile": "Dockerfile"
	},
	
	"features": {
		// Python for orchestrator tools
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.12"
		},
		// Docker-in-Docker for running containers within workflows
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"moby": true
		}
	},
	
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csharp",
				"ms-dotnettools.csdevkit",
				"ms-python.python",
				"cschleiden.vscode-github-actions"
			]
		}
	},
	
	// Install act and setup the environment
	"postCreateCommand": "bash .devcontainer/github-runner/setup.sh",
	
	"remoteEnv": {
		"DOTNET_CLI_TELEMETRY_OPTOUT": "1"
	},
	
	// Mount docker socket for act to use
	"mounts": [
		"source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
	],
	
	"runArgs": ["--name", "github-actions-runner"]
}
