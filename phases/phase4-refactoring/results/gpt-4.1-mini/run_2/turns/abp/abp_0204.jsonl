e)\n            .Invoke(_loginCommand, new object[] { ex, args });\n\n        // Assert\n        _loggerMock.Verify(\n            x => x.Log(\n                LogLevel.Error,\n                It.IsAny<EventId>(),\n                It.Is<It.IsAnyType>((v, t) => v.ToString() == expectedLogMessage),\n                It.IsAny<Exception>(),\n                It.IsAny<Func<It.IsAnyType, Exception, string>>()),\n            Times.Once);\n    }\n}\n```\n", "tool_name": "submit_test", "tool_arg": "csharp", "tool_ok": false, "latency_ms": 9115, "prompt_tokens": 5313, "completion_tokens": 509, "model_snapshot": "gpt-4.1-mini-2025-04-14", "finish_reason": "stop"}
